{
  "font-family": {
    "$type": "fontFamily",
    "sans": {
      "$value": [
        "ui-sans-serif",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "Roboto",
        "Helvetica Neue",
        "Arial",
        "sans-serif"
      ]
    },
    "mono": {
      "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"]
    }
  },
  "font-size": {
    "$type": "dimension",
    "$description": "rem-based so text respects the user's browser font-size setting.",
    "xs": { "$value": "0.75rem" },
    "sm": { "$value": "0.875rem" },
    "md": { "$value": "1rem" },
    "lg": { "$value": "1.125rem" },
    "xl": { "$value": "1.25rem" },
    "2xl": { "$value": "1.5rem" },
    "3xl": { "$value": "1.875rem" },
    "4xl": { "$value": "2.25rem" }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },
  "line-height": {
    "$type": "number",
    "tight": { "$value": 1.25 },
    "snug": { "$value": 1.375 },
    "normal": { "$value": 1.5 }
  }
}
