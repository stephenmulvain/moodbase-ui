{
  "color": {
    "$type": "color",
    "surface": { "$value": "{color.slate.950}", "$description": "Page background." },
    "surface-raised": { "$value": "{color.slate.900}", "$description": "Cards, panels, popovers." },
    "text": { "$value": "{color.slate.50}", "$description": "Primary text." },
    "text-muted": {
      "$value": "{color.slate.300}",
      "$description": "Secondary text. Still AA on every surface."
    },
    "border": { "$value": "{color.slate.800}", "$description": "Decorative dividers." },
    "border-strong": {
      "$value": "{color.slate.500}",
      "$description": "Input and control outlines (3:1 non-text contrast)."
    },
    "accent": {
      "$value": "{color.tide.300}",
      "$description": "Primary actions, links, selection."
    },
    "on-accent": {
      "$value": "{color.slate.950}",
      "$description": "Text and icons placed on an accent fill."
    },
    "success": { "$value": "{color.sage.300}" },
    "warning": { "$value": "{color.amber.300}" },
    "danger": {
      "$value": "{color.rose.300}",
      "$description": "Errors and destructive actions only, never mood."
    },
    "focus-ring": { "$value": "{color.tide.300}", "$description": "Keyboard focus outline." }
  }
}
